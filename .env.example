# RESEND_API_KEY: Server-only key for transactional email via Resend.
# Sender is hardcoded to noreply@send.agetolabs.com (verified domain).
# Get one at https://resend.com/api-keys
RESEND_API_KEY="re_..."

# CONTACT_TO_EMAIL: Inbox that receives contact form submissions.
CONTACT_TO_EMAIL="info@agetolabs.com"

# NEXT_PUBLIC_SITE_URL: Absolute site URL used by metadataBase, robots.ts,
# sitemap.ts, and Organization JSON-LD. Production: https://agetolabs.com.
# Set per-environment in Vercel (Preview/Development may override).
NEXT_PUBLIC_SITE_URL="https://agetolabs.com"

# TRUSTED_IP_HEADER: Self-hosted only (ignored on Vercel). Request header that
# carries the real client IP for the domain-lookup rate limit. Set it only if
# the reverse proxy overwrites that header from the peer address, e.g. nginx:
#   proxy_set_header X-Real-IP $remote_addr;
# Leave unset otherwise; the per-client limit is then skipped (global cap stays).
# TRUSTED_IP_HEADER="x-real-ip"
